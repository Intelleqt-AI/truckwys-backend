# TruckWys — ready-to-run DEV config. Copy to .env to run:  cp .env.dev .env
# Dev-grade only. Real production secrets go in a separate .env (never committed).
# NOTE: contains a shared dev TomTom key — rotate before production.

SECRET_KEY=dev-only-secret-not-for-production-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=True
FRONTEND_URL=http://localhost:3701

# Real-time push (run Redis locally: `redis-server` or `docker run -p 6379:6379 redis`)
REDIS_URL=redis://127.0.0.1:6379/0

# DB: left unset on purpose -> the app uses local SQLite automatically (no Postgres needed to test).

# Routing / tolls / weighbridge / cross-border cost engine — REQUIRED for accurate
# quoting (without it, distance falls back to a straight-line estimate).
# Paste the TomTom key here (ask David — shared privately, not committed to git).
TOMTOM_API_KEY=

# Payments stay in PayFast sandbox for testing.
PAYFAST_SANDBOX=True

# --- Optional: add your real keys to test these features ---
# OPENAI_API_KEY=           # Copilot (chat + DB tools + RAG), voice quoting
COPILOT_LLM_PROVIDER=openai # copilot DB tools/proposals ONLY run under OpenAI
# ANTHROPIC_API_KEY=        # AI quote parsing + insights (NOT copilot tools)
# RESEND_API_KEY=           # real invoice emails + payment reminders (see HANDOVER)
# EMAIL_FROM=TruckWys <onboarding@resend.dev>
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=
