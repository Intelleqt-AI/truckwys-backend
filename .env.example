# Django Settings
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite by default, can be changed to PostgreSQL)
DATABASE_URL=sqlite:///db.sqlite3
# For PostgreSQL:
# DATABASE_URL=postgres://user:password@localhost:5432/truckways

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Media and Static Files
MEDIA_ROOT=media/
STATIC_ROOT=staticfiles/

# Email Settings (for notifications)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password

# Redis (for Celery task queue)
REDIS_URL=redis://localhost:6379/0

# Celery Settings
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# API Settings
API_RATE_LIMIT=1000/hour

# Payment Gateway (placeholder for future integration)
PAYMENT_GATEWAY_API_KEY=
PAYMENT_GATEWAY_SECRET=

# External Services
# D&B Credit Score API (placeholder)
DNB_API_KEY=
DNB_API_SECRET=

# Application Settings
DEFAULT_FROM_EMAIL=noreply@truckwys.co.za
ADMIN_EMAIL=admin@truckwys.co.za

# Feature Flags
ENABLE_EARLY_PAYMENT=True
ENABLE_RISK_SCORING=True
ENABLE_AUTO_INVOICING=True
