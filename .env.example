# Django Settings
SECRET_KEY=generate-a-real-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,*.ngrok.io,app.truckwys.co.za,api.truckwys.co.za

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3701,https://app.truckwys.co.za
CORS_ALLOW_ALL_ORIGINS=False

# Frontend URL
FRONTEND_URL=https://app.truckwys.co.za

# Database (PostgreSQL for production)
DATABASE_URL=postgresql://user:password@host:port/database

# Email Settings (using Resend in production)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=TruckWys <noreply@truckwys.com>

# Resend Configuration (Production email service)
RESEND_API_KEY=re_xxx_your_resend_api_key
EMAIL_FROM=TruckWys <noreply@mail.baselinq.ai>
