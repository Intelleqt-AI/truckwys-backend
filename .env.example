# Django Settings
SECRET_KEY=generate-a-real-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,*.ngrok.io,app.truckwys.co.za,api.truckwys.co.za

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3701,https://app.truckwys.co.za
CORS_ALLOW_ALL_ORIGINS=False

# Frontend URL
FRONTEND_URL=https://app.truckwys.co.za

# Database (PostgreSQL for production)
DATABASE_URL=postgresql://user:password@host:port/database

# Email Settings (using Resend in production)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=no-reply@truckwys.com
EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx
DEFAULT_FROM_EMAIL=TruckWys <noreply@truckwys.com>

# Transactional email via Resend — REQUIRED for real invoice emails + payment
# reminders / dunning. Unset = the collections agent honestly no-ops (sends nothing).
RESEND_API_KEY=
EMAIL_FROM=TruckWys <noreply@mail.example.com>

# AI (optional; features gracefully fall back to rules/regex when unset).
# Set ANTHROPIC_API_KEY to make the Copilot + AI quote parsing use Claude.
ANTHROPIC_API_KEY=
# Set OPENAI_API_KEY to enable voice quote transcription (Whisper).
OPENAI_API_KEY=
CLAUDE_AGENT_MODEL=claude-opus-4-8
CLAUDE_INSIGHTS_MODEL=claude-opus-4-8
CLAUDE_QUOTE_MODEL=claude-opus-4-8

# Routing
TOMTOM_API_KEY=

# Real-time WebSockets — Redis powers the Channels layer for live event push.
REDIS_URL=redis://127.0.0.1:6379/0

# Lender API keys: JSON object {"KEY":"Name"} or "KEY:Name,KEY2:Name2". Empty = closed in prod.
LENDER_API_KEYS=

# Debtor credit bureau (Pillar 3 of the risk score). Unset = honest "no bureau data".
# CREDIT_BUREAU_PROVIDER one of: EXPERIAN | TRANSUNION | XDS | COMPUSCAN
CREDIT_BUREAU_PROVIDER=
CREDIT_BUREAU_API_KEY=
CREDIT_BUREAU_BASE_URL=

# Xero accounting sync (push invoices, reconcile payments). Create an app at
# developer.xero.com, add the redirect URI below to it, then paste the credentials.
# Unset = the Settings → Integrations → Xero screen honestly shows "not configured".
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:8000/api/v1/integrations/xero/callback/

# Carrier-finance spine: auto-raise the invoice (SENT, fast-pay eligible) when a
# load is delivered. Default on; set False to require the manual convert-to-invoice step.
AUTO_INVOICE_ON_DELIVERY=True

# Win-probability model: how many real accepted/rejected QuoteOutcome rows are needed
# before the model trains (below this it runs the heuristic). Default 40.
WIN_MODEL_MIN_SAMPLES=40

# Encryption key for secrets at rest (Xero OAuth tokens). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Unset = derived from SECRET_KEY. Set a dedicated key in production.
FIELD_ENCRYPTION_KEY=