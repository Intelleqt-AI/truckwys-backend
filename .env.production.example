# TruckWys backend — production .env template for the EC2 / docker-compose.prod.yml stack.
#
# On the server:   cp .env.production.example .env  &&  nano .env
# NEVER commit the filled-in .env. See DEPLOY_EC2.md.
#
# Replace every <ANGLE BRACKET> placeholder. Anything left blank makes the
# related feature no-op honestly rather than crash — that is by design.

# ─── Core Django ────────────────────────────────────────────────────────────
# Generate with:
#   docker compose -f docker-compose.prod.yml run --rm web python -c \
#     "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# If this is left at the dev default, settings.py silently generates a throwaway
# key per worker and every session / signed link breaks. Set it.
SECRET_KEY=<PASTE GENERATED KEY>
DEBUG=False

# Your EC2 Elastic IP (add the domain here later, comma-separated).
ALLOWED_HOSTS=<EC2_ELASTIC_IP>

# ONLY while this host has no TLS. A Secure cookie is never stored over plain
# http://, so with DEBUG=False the browser drops the CSRF cookie and admin login
# fails with "CSRF verification failed". Cookies travel in cleartext while these
# are False — delete both lines as soon as HTTPS is set up.
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SECURE=False

# ─── Database (Postgres container) ──────────────────────────────────────────
# POSTGRES_PASSWORD is read by the db container; DATABASE_URL is read by Django.
# The two passwords MUST match. Host is `db` — the compose service name.
POSTGRES_DB=truckwys
POSTGRES_USER=truckwys
POSTGRES_PASSWORD=<STRONG RANDOM PASSWORD>
DATABASE_URL=postgresql://truckwys:<SAME PASSWORD>@db:5432/truckwys

# ─── Redis (Celery broker + Channels/WebSocket layer) ───────────────────────
# Host is `redis` — the compose service name, not localhost.
REDIS_URL=redis://redis:6379/0

# ─── Frontend / CORS ────────────────────────────────────────────────────────
# Until the frontend is deployed, point these at the same IP. Once the SPA is
# live, set them to its real origin (e.g. https://app.truckwys.co.za).
FRONTEND_URL=http://<EC2_ELASTIC_IP>
CORS_ALLOWED_ORIGINS=http://<EC2_ELASTIC_IP>
CORS_ALLOW_ALL_ORIGINS=False
CSRF_TRUSTED_ORIGINS=http://<EC2_ELASTIC_IP>

# ─── Email (Resend) ─────────────────────────────────────────────────────────
# REQUIRED in practice: login 2FA OTP, email verification, password reset and
# invoice/dunning mail all go out through here (via the Celery worker).
RESEND_API_KEY=<YOUR RESEND KEY>
EMAIL_FROM=TruckWys <noreply@mail.example.com>
DEFAULT_FROM_EMAIL=TruckWys <noreply@mail.example.com>

# ─── AI (Copilot) ───────────────────────────────────────────────────────────
# Keep provider=openai — the copilot's database tools only work under OpenAI.
OPENAI_API_KEY=<YOUR OPENAI KEY>
COPILOT_LLM_PROVIDER=openai
OPENAI_CHAT_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# ─── Routing ────────────────────────────────────────────────────────────────
TOMTOM_API_KEY=<YOUR TOMTOM KEY>

# ─── Secrets at rest (Xero OAuth tokens) ────────────────────────────────────
# Generate:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=<PASTE GENERATED FERNET KEY>

# ─── Payments (PayFast) ─────────────────────────────────────────────────────
# Leave SANDBOX=True until you have verified the flow end to end with real
# merchant credentials. These defaults are PayFast's public sandbox account.
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=True

# ─── Celery ─────────────────────────────────────────────────────────────────
# Blank = fall back to REDIS_URL. Must stay False in prod: True would run tasks
# inline in the web process and defeat the worker.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=False
# Worker processes. docker-entrypoint.sh defaults to 2; each forks a full Django
# process (~400 MB with numpy/openai imported), which a 2 GB t3.small can't
# afford alongside Postgres, Redis, gunicorn and beat. Raise this after moving
# to a bigger instance.
CELERY_CONCURRENCY=1

# ─── Optional integrations (blank = cleanly disabled) ───────────────────────
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://<EC2_ELASTIC_IP>/api/v1/integrations/xero/callback/
CONTROLFLEET_API_KEY=
CONTROLFLEET_WEBHOOK_KEY=
CREDIT_BUREAU_PROVIDER=
CREDIT_BUREAU_API_KEY=
CREDIT_BUREAU_BASE_URL=
LENDER_API_KEYS=
ANTHROPIC_API_KEY=

# ─── Business rules ─────────────────────────────────────────────────────────
AUTO_INVOICE_ON_DELIVERY=True
WIN_MODEL_MIN_SAMPLES=40
RISK_ML_WEIGHT=0.0
TIME_ZONE=Africa/Johannesburg
